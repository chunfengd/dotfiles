def cmd_guide(args):
    sys.stdout.write(GUIDE)
    return EXIT_OK


# ---------------------------------------------------------------------------
# Argument parsing
#
# Subcommands are listed by purpose in TOP_DESCRIPTION rather than dumped
# alphabetically by argparse, and every subparser carries an examples: epilog.
# tests/test_orgcli.py asserts both, so a new command cannot ship undocumented.
# ---------------------------------------------------------------------------


class Formatter(argparse.RawDescriptionHelpFormatter):
    def __init__(self, prog, **kwargs):
        kwargs.setdefault("max_help_position", 30)
        super().__init__(prog, **kwargs)


def add_file(parser, required=True):
    """`required=False` is for the recovery commands, which default to acting
    on every file that has queued edits or backups rather than just one."""
    parser.add_argument(
        "-f", "--file", metavar="FILE",
        help="org file; a bare name like 'tools' resolves to $ORGCLI_DIR/tools.org "
             "(default: $ORGCLI_FILE)" if required else
             "org file to narrow to (default: all of them)")


def add_target(parser, required_text="the node to act on", optional=False):
    group = parser.add_argument_group("addressing", required_text)
    group.add_argument("--path", metavar="P",
                       help="heading path, '/'-separated, case-insensitive; "
                            "escape a literal slash as '\\/'")
    group.add_argument("--id", metavar="UUID", help="org-id from the :ID: property")
    group.add_argument("--line", type=int, metavar="N",
                       help="line number the heading starts on")
    group.add_argument("--strict-root", action="store_true",
                       help="require the first --path segment to be a level-1 heading")


def add_write(parser):
    group = parser.add_argument_group("write safety")
    group.add_argument("--dry-run", action="store_true",
                       help="print a unified diff and change nothing")
    group.add_argument("--if-match", metavar="HASH",
                       help="refuse (exit 3) unless the node's hash still matches")
    group.add_argument("--no-backup", action="store_true",
                       help="skip the pre-write backup to $ORGCLI_BACKUP_DIR")
    group.add_argument("--ensure-id", action="store_true",
                       help="mint an :ID: for the node if it has none")


def add_text(parser):
    group = parser.add_argument_group("body text", "one of these, or bare stdin")
    group.add_argument("--text", metavar="STR", help="text given inline")
    group.add_argument("--text-file", metavar="PATH",
                       help="read text from a file, or '-' for stdin")


def add_json(parser):
    parser.add_argument("--json", action="store_true",
                        help="emit one JSON object instead of ---SECTION--- blocks")


def sub(subparsers, name, help_text, epilog):
    # Passing no `help` at all is what keeps argparse from printing a second,
    # alphabetical command list underneath the grouped one in TOP_DESCRIPTION.
    # (help=SUPPRESS does not work here: add_parser stores the sentinel string
    # and prints it.) The test suite checks the grouped list and the registered
    # subparsers stay in sync.
    return subparsers.add_parser(
        name, description=help_text, epilog=epilog, formatter_class=Formatter)


def build_parser():
    parser = argparse.ArgumentParser(
        prog="orgcli", description=TOP_DESCRIPTION, epilog=TOP_EPILOG,
        formatter_class=Formatter)
    parser.add_argument("--version", action="version", version="orgcli 1.0.0")
    subparsers = parser.add_subparsers(dest="cmd", metavar="<command>",
                                       title="commands")

    # -- read ------------------------------------------------------------

    p = sub(subparsers, "outline", "Heading tree, with sizes and descriptions.", """\
examples:
  # the whole file as a routing table - start here
  orgcli outline -f tools --depth 1 --desc --stats

  # drill into one subtree
  orgcli outline -f tools --path acl --depth 3

  # everything still open in the daily log
  orgcli outline -f daily --todo TODO
""")
    add_file(p)
    add_target(p, "optional: scope the outline to one subtree")
    p.add_argument("--depth", type=int, metavar="N",
                   help="levels to show, counting the scope root as 1")
    p.add_argument("--stats", action="store_true",
                   help="append each node's line and byte count")
    p.add_argument("--desc", action="store_true",
                   help="append each node's description")
    p.add_argument("--todo", nargs="?", const="*", metavar="STATE",
                   help="only nodes with a TODO keyword, or with this one")
    p.add_argument("--tag", metavar="TAG", help="only nodes carrying this tag")
    add_json(p)
    p.set_defaults(func=cmd_outline)

    p = sub(subparsers, "show", "Print one node.", """\
examples:
