# Write commands
# ---------------------------------------------------------------------------


def cmd_set_body(args):
    doc, node = begin_write(args)
    new = text_to_lines(read_text(args), doc.nl)
    start = doc.body_start(node)
    end = node.end if args.include_children else node.own_end
    return commit(doc, args, doc.lines[:start] + new + doc.lines[end:], node.line)


def cmd_append(args):
    doc, node = begin_write(args)
    new = text_to_lines(read_text(args), doc.nl)
    at = node.own_end  # end of this node's own body, before any children
    return commit(doc, args, doc.lines[:at] + new + doc.lines[at:], node.line)


def cmd_prepend(args):
    doc, node = begin_write(args)
    new = text_to_lines(read_text(args), doc.nl)
    at = doc.body_start(node)  # after the planning line and property drawer
    return commit(doc, args, doc.lines[:at] + new + doc.lines[at:], node.line)


def cmd_add(args):
    doc = load(args)
    if args.parent is not None:
        if args.path is not None:
            raise UsageError("--parent and --path are the same thing; give one")
        args.path = args.parent
    root_level = args.root or args.path == "/"
    if args.path == "/":
        args.path = None
    if not root_level and args.path is None and args.id is None and args.line is None:
        # Never default to top level: a typo'd --parent should fail loudly, not
        # quietly append a new level-1 node to the file.
        raise UsageError("give --parent/--path/--id/--line for the parent node, "
                         "or --root to create a top-level node")

    if root_level:
        parent, siblings, level = None, doc.roots, 1
    else:
        parent = doc.resolve(args)
        check_if_match(doc, parent, args)
        siblings, level = parent.children, parent.level + 1
    if args.level is not None:
        level = args.level

    if args.before or args.after:
        want = norm(args.before or args.after)
        match = [n for n in siblings if norm(n.title) == want]
        if not match:
            raise NotFoundError('no sibling titled "%s"'
                                % (args.before or args.after))
        if len(match) > 1:
            raise AmbiguousError('sibling "%s" is not unique'
                                 % (args.before or args.after), match)
        at = match[0].start if args.before else match[0].end
    elif args.position == "first":
        at = (siblings[0].start if siblings
              else (len(doc.lines) if parent is None else parent.own_end))
    else:
        at = len(doc.lines) if parent is None else parent.end

    node = Node(level, 0)
    node.title = args.title
    node.todo = args.todo
    node.tags = parse_tags(args.tag)
    block = [render_heading(node, doc.nl)]
    text = read_text(args, required=False)
    if text:
        block += text_to_lines(text, doc.nl)

    new_lines = doc.lines[:at] + block + doc.lines[at:]
    return commit(doc, args, new_lines, at + 1)


def cmd_delete(args):
    doc, node = begin_write(args)
    if not args.yes and not args.dry_run:
        raise UsageError("refusing to delete %d lines without --yes "
                         "(or use --dry-run to preview)" % (node.end - node.start))
    return commit(doc, args, doc.lines[:node.start] + doc.lines[node.end:])


def cmd_set_heading(args):
    doc, node = begin_write(args)
    node.title = args.title
    lines = list(doc.lines)
    lines[node.start] = render_heading(node, doc.nl)
    return commit(doc, args, lines, node.line)


def cmd_todo(args):
    doc, node = begin_write(args)
    old = node.todo
    if args.clear:
        new_state = None
    else:
        new_state = args.state
        known = doc.all_keywords
        if new_state.upper() in [k.upper() for k in known]:
            new_state = next(k for k in known if k.upper() == new_state.upper())
        elif not args.force:
            raise UsageError(
                "%s is not a TODO keyword in %s (known: %s). Use --force to "
                "set it anyway." % (new_state, os.path.basename(doc.path),
                                    " ".join(known)))
    if old == new_state:
        return commit(doc, args, list(doc.lines), node.line)

    node.todo = new_state
    lines = list(doc.lines)
    lines[node.start] = render_heading(node, doc.nl)

    if args.log_state:
        # Same shape Emacs writes from org-log-note-headings' "%-12s" fields,
        # so the line is indistinguishable from the ones already in daily.org.
        stamp = time.strftime("%Y-%m-%d %a %H:%M")
        entry = '- State %s from %s [%s]' % (
            ('"%s"' % (new_state or "")).ljust(12),
            ('"%s"' % (old or "")).ljust(12), stamp)
        at = log_insert_point(doc, node)
        lines = lines[:at] + [entry + doc.nl] + lines[at:]
    return commit(doc, args, lines, node.line)


def log_insert_point(doc, node):
    """Top of an existing :LOGBOOK: drawer, else the start of the body.

    daily.org uses both styles - 302 drawers and ~300 bare '- State ...' lines
    - so match whichever the node already has instead of imposing one.
    """
    start = doc.body_start(node)
    if start < node.own_end:
        m = DRAWER_OPEN_RE.match(doc.text[start])
        if m and m.group(2).upper() == "LOGBOOK":
            return start + 1
    return start


def cmd_tag(args):
    doc, node = begin_write(args)
    tags = list(node.tags)
    for tag in parse_tags(args.add):
        if tag not in tags:
            tags.append(tag)
    for tag in split_csv(args.remove):
        if tag in tags:
            tags.remove(tag)
    node.tags = tags
    lines = list(doc.lines)
    lines[node.start] = render_heading(node, doc.nl)
    return commit(doc, args, lines, node.line)


def cmd_prop(args):
    doc, node = begin_write(args)
    updates = {}
    for item in args.set or []:
        key, sep, value = item.partition("=")
        if not sep:
            raise UsageError("--set expects KEY=VALUE, got %r" % item)
        updates[key.strip()] = value.strip()
    for key in args.unset or []:
        updates[key.strip()] = None
    if not updates:
        raise UsageError("nothing to do: pass --set KEY=VALUE or --unset KEY")
    return commit(doc, args, set_properties(doc, node, updates), node.line)


def split_csv(value):
    if not value:
        return []
    return [v.strip() for v in re.split(r"[,:]", value) if v.strip()]


VALID_TAG_RE = re.compile(r"^[A-Za-z0-9_@#%]+$")


def parse_tags(value):
    """Split and validate a --tag/--add list.

    Org only allows [A-Za-z0-9_@#%] in a tag. Writing anything else produces a
    ':foo bar:' that org does not read back as a tag, so the text silently
    becomes part of the title instead - reject it here rather than corrupt the
    heading.
    """
    tags = split_csv(value)
    bad = [t for t in tags if not VALID_TAG_RE.match(t)]
    if bad:
        raise UsageError(
            "invalid tag(s) %s: org tags may only contain letters, digits and "
            "_ @ # %%" % ", ".join(repr(t) for t in bad))
    return tags


# ---------------------------------------------------------------------------
# Recovery commands: pending, sync, restore
# ---------------------------------------------------------------------------


def cmd_pending(args):
    """List, drop or clear queued edits."""
    path = resolve_file(args.file) if args.file else None
    entries = queue_entries(path)

    if args.clear:
        for entry in entries:
            queue_drop(entry)
        return report(args, "cleared", path or pending_dir(),
                      queued=len(entries))
    if args.drop:
        hit = [e for e in entries if e["id"] == args.drop]
        if not hit:
            raise NotFoundError("no queued edit with id %s" % args.drop)
        queue_drop(hit[0])
        return report(args, "dropped", hit[0]["file"], queued=args.drop)

    if args.json:
        emit_json({
            "pending": [{k: v for k, v in e.items() if not k.startswith("_")}
                        for e in entries],
            "count": len(entries),
        })
        return EXIT_OK

    section("PENDING", None)
    for entry in entries:
        sys.stdout.write("%s  %s\n" % (entry["id"], entry["file"]))
        sys.stdout.write("    created=%s  pre=%s  post=%s\n"
                         % (entry["created"], entry["pre_sha"][:HASH_LEN],
                            entry["post_sha"][:HASH_LEN]))
        sys.stdout.write("    reason=%s\n" % entry["reason"])
        sys.stdout.write("    argv=%s\n" % " ".join(entry.get("argv") or []))
    section("SUMMARY", "count=%d  dir=%s" % (len(entries), pending_dir()))
    return EXIT_OK if entries else EXIT_NO_MATCH


class SyncConflict(Exception):
    def __init__(self, entry, live_sha):
        super().__init__(entry["id"])
        self.entry = entry
        self.live_sha = live_sha


def sync_file(path, entries, dry_run=False, force=False):
    """Replay one file's queue in order. Returns (applied, conflict-or-None).

    Each entry records the sha of the content it was computed against. If that
    still matches what is on the mount, writing the recorded content is
    byte-identical to having run the original command now. If it does not,
    something else edited the file while we were offline - stop, keep the
    entry, and let a human look.
    """
    applied = []
    for entry in entries:
        arm_timeout()  # each entry gets its own budget, not a shared one
        doc = OrgDoc.load(path, allow_mirror=False)
        live = doc.content()
        live_sha = sha_of(live)
        if live_sha != entry["pre_sha"] and not force:
            return applied, SyncConflict(entry, live_sha)
        content = queue_content(entry)
        if dry_run:
            applied.append((entry, None))
            continue
        try:
            backup = make_backup(path, live)
            atomic_write(path, content)
        except OSError as exc:
            # The mount died again mid-replay. Classify so autosync can treat
            # it as "still offline" and let the caller queue onto the end,
            # rather than surfacing a bare OSError.
            raise classify_oserror(exc, path)
        mirror_put(path, content)
        queue_drop(entry)
        applied.append((entry, backup))
    return applied, None


def cmd_sync(args):
    path = resolve_file(args.file) if args.file else None
    entries = queue_entries(path)
    if not entries:
        return report(args, "nothing-to-sync", path or pending_dir(), queued=0)

    by_file = {}
    for entry in entries:
        by_file.setdefault(entry["file"], []).append(entry)

    applied, conflicts = [], []
    for target in sorted(by_file):
        done, conflict = sync_file(target, by_file[target],
                                   dry_run=args.dry_run, force=args.force)
        applied.extend(done)
        if conflict is not None:
            conflicts.append(conflict)

    status = "dry-run" if args.dry_run else ("conflict" if conflicts else "synced")
    if args.json:
        emit_json({
            "status": status,
            "applied": [e["id"] for e, _ in applied],
            "conflicts": [{
                "id": c.entry["id"], "file": c.entry["file"],
                "expected_sha": c.entry["pre_sha"], "live_sha": c.live_sha,
                "content": c.entry["_body"],
            } for c in conflicts],
            "remaining": len(queue_entries(path)),
        })
        return EXIT_PRECONDITION if conflicts else EXIT_OK

    section("SUMMARY", "status=%s  applied=%d  conflicts=%d  remaining=%d"
            % (status, len(applied), len(conflicts), len(queue_entries(path))))
    if applied:
        section("APPLIED", "".join(
            "%s  %s%s\n" % (e["id"], e["file"], "  backup=%s" % b if b else "")
            for e, b in applied))
    if conflicts:
        body = []
        for c in conflicts:
            body.append(
                "%s  %s\n  the file changed since this edit was made\n"
                "  expected %s but found %s\n"
                "  queued content: %s\n"
                "  resolve with:   diff %s %s\n"
                "  then:           orgcli sync --force   (or: orgcli pending --drop %s)\n"
                % (c.entry["id"], c.entry["file"],
                   c.entry["pre_sha"][:HASH_LEN], c.live_sha[:HASH_LEN],
                   c.entry["_body"], c.entry["file"], c.entry["_body"],
                   c.entry["id"]))
        section("CONFLICTS", "".join(body))
    return EXIT_PRECONDITION if conflicts else EXIT_OK


def autosync(path):
    """Drain `path`'s queue before a write command touches it.

    Only write commands call this. A read must never have the side effect of
    writing to the user's notes, so reads just warn (see warn_pending).
    """
    entries = queue_entries(path)
    if not entries:
        return
    try:
        applied, conflict = sync_file(path, entries)
    except StorageError as exc:
        # Still offline. Nothing can be replayed, but the command that follows
        # can still queue onto the end - so warn and get out of its way rather
        # than failing it for a condition it is designed to survive.
        warn("cannot flush %d queued edit(s) yet: %s" % (len(entries), exc.message))
        return
    if applied:
        section("SYNCED", "".join("%s  (queued %s)\n" % (e["id"], e["created"])
                                  for e, _ in applied))
    if conflict is not None:
        raise PreconditionError(
            "%s has %d queued edit(s) that no longer apply: %s expected the "
            "file at %s but it is now %s. Resolve with `orgcli sync` before "
            "writing again."
            % (path, len(queue_entries(path)), conflict.entry["id"],
               conflict.entry["pre_sha"][:HASH_LEN], conflict.live_sha[:HASH_LEN]))


def warn_pending(path):
    n = len(queue_entries(path))
    if n:
        warn("%d edit(s) queued for %s are not on gdrive yet; run: orgcli sync"
             % (n, path))


def backups_for(path):
    """Every backup of `path`'s basename, newest first."""
    directory = backup_dir()
    prefix = os.path.basename(path) + "." if path else ""
    try:
        names = [n for n in os.listdir(directory) if n.startswith(prefix)]
    except OSError:
        return []
    out = []
    for name in sorted(names, reverse=True):
        full = os.path.join(directory, name)
        try:
            stat = os.stat(full)
        except OSError:
            continue
        out.append((name, full, stat))
    return out


def cmd_restore(args):
    """Put a backup from $ORGCLI_BACKUP_DIR back. The safety net already
    existed; this is the UI for it."""
    path = resolve_file(args.file) if args.file else None

    if args.list or not args.backup:
        found = backups_for(path)
        if args.json:
            emit_json({"dir": backup_dir(), "file": path, "backups": [
                {"name": n, "path": p, "bytes": s.st_size,
                 "modified": time.strftime("%Y-%m-%dT%H:%M:%S",
                                           time.localtime(s.st_mtime))}
                for n, p, s in found]})
            return EXIT_OK if found else EXIT_NO_MATCH
        section("BACKUPS", None)
        for name, _, stat in found:
            sys.stdout.write("%s  %8s  %s\n" % (
                time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(stat.st_mtime)),
                human_size(stat.st_size), name))
        section("SUMMARY", "count=%d  dir=%s" % (len(found), backup_dir()))
        if not args.backup:
            return EXIT_OK if found else EXIT_NO_MATCH

    if not path:
        raise UsageError("restoring needs --file, so orgcli knows where to put it")
    source = args.backup
    if os.sep not in source:
        source = os.path.join(backup_dir(), source)
    try:
        with open(source, "r", encoding="utf-8", newline="") as fh:
            content = fh.read()
    except OSError as exc:
        raise UsageError("cannot read backup %s: %s" % (source, exc))

    try:
        live = raw_read(path)
    except FileNotFoundError:
        # The org file is gone, which is exactly what restore is for. Do not
        # apply the mirror heuristic classify_oserror uses for reads - it
        # would read "we have seen this file before" as a dead mount and
        # refuse. Restore is explicit, so instead just check that the
        # directory is genuinely reachable before recreating the file in it.
        try:
            os.stat(os.path.dirname(path) or ".")
        except OSError as exc:
            raise classify_oserror(exc, path)
        live = ""
    except OSError as exc:
        raise classify_oserror(exc, path)
    if live == content:
        return report(args, "unchanged", path)
    if args.dry_run:
        return report(args, "dry-run", path,
                      [("DIFF", diff_text(live, content, path))])
    backup = make_backup(path, live)
    try:
        atomic_write(path, content)
    except OSError as exc:
        raise classify_oserror(exc, path)
    mirror_put(path, content)
    return report(args, "restored", path, backup=backup)


# ---------------------------------------------------------------------------
# guide - the page an agent reads before its first call
# ---------------------------------------------------------------------------

GUIDE = """\
orgcli - working with big org files without reading them
========================================================

The point of this tool is that you never `Read` the .org file. tools.org is
6,000 lines and archive.org is 24,000; a cftask logs.org can be 2.4 MB. Load
one node instead.

1. The read ladder - cheapest first
-----------------------------------

  orgcli outline -f tools --depth 1 --desc --stats
      The whole file as ~120 lines: title, description, and how big each node
      is. Read this first. --stats tells you what a `show` will cost before
      you pay for it.

  orgcli search -f tools 'hipstercli' --context 1
      Line hits with the owning node's path. Use this when you know a literal
      term but not where it lives.

  orgcli show -f tools --path 'acl/bulk edit'
      Exactly one subtree. Add --depth 1 for the node's own body without its
      children, or --max-lines 80 to cap a node you are not sure about.

Only fall back to Read/Grep on the raw file if orgcli cannot express what you
need - and if you do, `orgcli path -f tools --line <N>` converts a line number
back into a stable heading path. The line need not be a heading: any line
resolves to the node containing it.

2. Addressing
-------------

Every node-targeting command takes exactly one of --path, --id, --line.

  --path 'acl/bulk edit/copy_permissions'
      Case-insensitive, whitespace-normalised, '/'-separated. Escape a literal
      slash in a title as '\\/' - e.g. --path 'hg \\/ jf \\/ sl'.
      Segments must be a contiguous parent->child chain, but need not start at
      the top: --path copy_permissions finds that node at whatever depth it
      lives. If exactly one match is shallowest, that one wins; otherwise you
      get exit 4 and a ---CANDIDATES--- list of "<line>\\t<full path>". Re-run
      with a longer --path or with --line from that list.
  --line N   the heading must start on line N. Unambiguous, but only valid
             until the file changes.
  --id UUID  from the node's :PROPERTIES: drawer. Nodes have no ID until you
             mint one with `orgcli id --path P --ensure`; do that when you
             expect to edit a node repeatedly across a long session.

3. Writing
----------

Read, then write with the hash you read:

    h=$(orgcli show -f tools --path 'acl/amp' --json | python3 -c \\
        'import json,sys; print(json.load(sys.stdin)["hash"])')
    orgcli append -f tools --path 'acl/amp' --if-match "$h" --text '- new bullet'

--if-match makes the write fail (exit 3) if the node changed since you read
it, which is the only protection against clobbering a concurrent edit from
Emacs or another agent. Always preview a non-trivial change with --dry-run
first; it prints a unified diff and writes nothing.

Body text comes from --text, --text-file PATH, --text-file - , or bare stdin.
Prefer a heredoc for anything multi-line - org bodies are full of '*', '=' and
'$', and shell quoting is where hand-built commands corrupt notes:

    orgcli set-body -f tools --path 'acl/amp' --text-file - <<'EOF'
    - bunnylol =amp=
    #+begin_src sh
      $ hipstercli add --reason $TASK
    #+end_src
    EOF

Which command:
    append / prepend   add to the end / start of a node's own body
    set-body           replace the body; children survive unless
                       --include-children
    add                new child node (--parent P, or --root for top level)
    set-heading        rename, preserving TODO state, priority and tags
    delete             remove a subtree; needs --yes
    todo / tag / prop  metadata, without touching the body
    describe           set the node's one-line summary

Every write backs the file up to ~/.cache/orgcli/backups first.
There is no move/refile/promote/demote: restructuring is a human's job.

4. Descriptions
---------------

A one-line summary per node, so the next agent can route from `outline` alone
instead of reading bodies. Stored as a :DESCRIPTION: property:

    orgcli describe -f tools --path acl --text 'ACL management for Hipster: ...'

Reads also accept the older convention - a '** description' child section, as
used by ~30 nodes in tools.org - so nothing needs migrating first. Writes
always go to the property. `orgcli describe --missing --depth 1` lists nodes
that have neither; it never writes.

After adding or renaming a level-1 node in tools.org, re-run
`orgcli index -f tools` to refresh tools.index.md.

5. Output and exit codes
------------------------

Plain output is ---SECTION--- blocks; --json gives one object per command and
is what you want if you are parsing. Common JSON keys: path, title, level,
start, end, lines, hash, todo, tags, id, description.

    0  ok
    1  no match            the path/id/line resolved to nothing, or a search
                           found nothing
    2  usage or file error  fix the command
    3  --if-match failed    re-read the node and retry with the new hash;
                           also a sync conflict, which needs `orgcli sync`
    4  ambiguous --path     see ---CANDIDATES---, then use a longer path or
                           --line
    5  storage unavailable  the gdrive mount is down. THE ONLY CODE WORTH
                           RETRYING. Do not treat it as "not found" and do
                           not re-create the node you were looking for.

6. Files
--------

-f accepts a bare name resolved against $ORGCLI_DIR (default ~/gdrive/org-meta),
so `-f tools` means ~/gdrive/org-meta/tools.org. Anything with a '/' or a
'.org' suffix is used as a path. $ORGCLI_FILE sets a default.

7. When the mount is down
-------------------------

The notes sit on a fuse.rclone gdrive mount that dies periodically. orgcli is
built to keep going rather than block you, but the cost is that "the command
succeeded" and "gdrive has your edit" stop being the same thing. Read the
status, not just the exit code.

  Reads   Exit 5 when the file is unreachable. That is the default: orgcli
          does not keep a copy of your notes unless you ask it to.

          Set ORGCLI_MIRROR=1 and every good read is copied to
          ~/.cache/orgcli/mirror; an unreachable file is then served from
          there, stale, with a warning on stderr (never stdout, so --json
          stays parseable). Worth it if you work through outages; the cost is
          a second copy on local disk that can be handed back in place of the
          real file.

  Writes  A write that cannot reach the mount - or that edited a doc which
          came from the mirror, and so might be behind the real file - is
          parked in ~/.cache/orgcli/pending and reported as

              status=queued  queued=<id>  reason=...

          Exit 0, because nothing was lost: the edit is on local disk. But it
          is NOT on gdrive. Never report a queued edit to the user as saved.

          A file holds at most one queued edit unless orgcli can tell what the
          previous one left behind - which needs ORGCLI_MIRROR=1. Without it a
          second edit exits 3 and is dropped rather than queued, because it
          was computed against the pre-queue file and applying both would
          revert the first. The queue itself is untouched; sync it and redo.

  Draining  The next write to that file replays its queue first and prints
          ---SYNCED---. `orgcli sync` does it on demand; `orgcli pending`
          lists what is waiting and exits 1 when nothing is, so
          `orgcli pending >/dev/null` answers "is everything flushed?".

  Conflicts  Each queued edit remembers the hash of the content it was built
          on. If the file changed underneath - Emacs, another machine - sync
          stops on that file with exit 3 rather than guessing. It prints the
          path of the queued content so you can diff it, then either
          `orgcli sync --force` or `orgcli pending --drop <id>`.

If the mount is down, fixing it beats working around it - remount, then
`orgcli sync`. The queue is there so a mount that dies mid-session does not
cost you the edit, not as a substitute for a working mount.

`orgcli restore --list` shows the pre-write backups, and
`orgcli restore -f <file> --backup <name>` rolls one back. Restoring takes its
own backup first, so it is undoable too.

To rehearse any of this without breaking a real mount, set ORGCLI_FAULT to
read, write, rename, both or hang - it makes the filesystem calls fail on
purpose and is inert when unset.
"""

# The grouped command list in `orgcli --help`. Rendered from this rather than
# hand-written prose so it cannot drift from the registered subcommands; the
# test suite asserts the two sets are equal.
COMMAND_GROUPS = [
    ("READ", [
        ("outline", "heading tree, with sizes, TODO states, descriptions"),
        ("show", "one node's content"),
        ("search", "regex over headings and/or bodies"),
        ("path", "line number or ID -> heading path"),
        ("describe", "read or set a node's one-line summary"),
        ("props", "property drawer"),
        ("id", "read or mint an org-id UUID"),
        ("index", "regenerate <file>.index.md"),
        ("guide", "the recommended agent workflow, in full"),
    ]),
    ("WRITE", [
        ("append", "add to the end of a node's body"),
        ("prepend", "add to the start of a node's body"),
        ("set-body", "replace a node's body"),
        ("add", "create a new node"),
        ("delete", "remove a subtree"),
        ("set-heading", "rename a node"),
        ("todo", "set or clear a TODO state"),
        ("tag", "add or remove tags"),
        ("prop", "set or unset properties"),
        ("migrate-descriptions", "'** description' children -> properties"),
    ]),
    ("RECOVERY", [
        ("pending", "edits queued while storage was unavailable"),
        ("sync", "replay queued edits onto the real file"),
        ("restore", "list or roll back to a pre-write backup"),
    ]),
]


def render_command_groups():
    width = max(len(name) for _, cmds in COMMAND_GROUPS for name, _ in cmds)
    gutter = max(len(label) for label, _ in COMMAND_GROUPS) + 1
    out = []
    for label, cmds in COMMAND_GROUPS:
        for i, (name, blurb) in enumerate(cmds):
            out.append("%s%s  %s" % ((label if i == 0 else "").ljust(gutter),
                                     name.ljust(width), blurb))
        out.append("")
    return "\n".join(out)


