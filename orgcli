    p.add_argument("--context", type=int, default=0, metavar="N",
                   help="lines of context around each hit")
    p.add_argument("--limit", type=int, default=50, metavar="N",
                   help="stop after N matches (default: 50)")
    add_json(p)
    p.set_defaults(func=cmd_search)

    p = sub(subparsers, "path", "Turn a line number or ID into a heading path.", """\
examples:
  # you found line 2359 with Grep; what node is that?
  orgcli path -f tools --line 2359

