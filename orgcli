# Commands that can write to the org file, and so should drain that file's
# queue before acting. The rest only warn - a read must never have the side
# effect of writing to the user's notes.
WRITE_COMMANDS = frozenset(name for name, _ in dict(COMMAND_GROUPS)["WRITE"])


def before_dispatch(args):
    """Reconcile the queue for the file this command is about to touch."""
    if args.cmd in ("pending", "sync", "restore"):
        return  # these manage the queue; they must not recurse into it
    try:
        path = resolve_file(getattr(args, "file", None))
    except UsageError:
        return  # the command will raise its own, better error in a moment
    if args.cmd in WRITE_COMMANDS and not getattr(args, "dry_run", False):
        autosync(path)
    else:
        warn_pending(path)


def main(argv=None):
    global ARGV
    ARGV = list(sys.argv[1:] if argv is None else argv)
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "cmd", None):
        parser.print_help()
        return EXIT_USAGE

    if args.cmd == "todo" and not args.clear and not args.state:
        parser.error("todo needs --state STATE or --clear")
    if args.cmd == "tag" and not args.add and not args.remove:
        parser.error("tag needs --add and/or --remove")

    try:
        arm_timeout()
        before_dispatch(args)
        return args.func(args)
    except AmbiguousError as exc:
        sys.stderr.write("orgcli: %s\n" % exc.message)
        print_candidates(None, exc.candidates)
        return exc.code
    except OrgCliError as exc:
        sys.stderr.write("orgcli: %s\n" % exc.message)
        return exc.code
    except BrokenPipeError:
        # Must precede the OSError clause below - it is a subclass, and this
        # one is not an error at all, just `| head`.
        try:
            sys.stdout.close()
        except Exception:
            pass
        return EXIT_OK
    except OSError as exc:
        # Backstop. Every filesystem call worth naming is classified at its
        # own call site; this makes sure the ones that are not still produce a
        # usable exit code instead of a traceback.
        err = classify_oserror(exc, getattr(exc, "filename", None))
        sys.stderr.write("orgcli: %s\n" % err.message)
        return err.code
    except KeyboardInterrupt:
        return 130
    finally:
        disarm_timeout()


if __name__ == "__main__":
    sys.exit(main())
