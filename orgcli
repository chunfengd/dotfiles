#!/usr/bin/env python3
"""orgcli - structured read/write access to large org-mode files.

Address one node, read one node, change one node. Nothing here ever needs the
whole file in an agent's context: `outline` gives a map with per-node sizes,
`search` gives line hits, `show` gives exactly one subtree.

Every edit is a line splice on the original line list, so bytes the tool did
not target round-trip exactly - no reflowing, no re-indenting, no normalising
of anything it did not touch. `tests/test_orgcli.py` asserts that invariant
against the real note corpus.

Addressing (node-targeting commands take exactly one):

    --path 'acl/bulk edit/copy_permissions'
        '/'-separated, case-insensitive, whitespace-normalised. A literal
        slash inside a title is escaped '\\/'. The segments must form a
        contiguous ancestor chain but need not start at level 1, so
        --path copy_permissions works like a plain title lookup at any depth.
        Ambiguity is never guessed: exit 4 with every candidate listed.
    --id 4f3a1c8e-...      org-id UUID from the node's :PROPERTIES: drawer.
    --line 2359            a heading must start exactly on that line.

Writes take --dry-run (unified diff, no write), --if-match <hash> (refuse if
the subtree changed since you read it) and back the file up first unless
--no-backup.

The notes live on a gdrive FUSE mount that dies periodically, so a write orgcli
cannot deliver is queued rather than lost: it reports status=queued and is
replayed by the next write to that file, or by `orgcli sync`. status=queued
means the edit is safe on local disk and is *not* on gdrive. An unreachable
read is exit 5; set ORGCLI_MIRROR=1 to keep a local copy of every file read and
serve that instead. See `orgcli guide` section 7.

Exit codes: 0 ok, 1 no match, 2 usage/file error, 3 --if-match failed or sync
conflict, 4 ambiguous match, 5 storage unavailable (the only one worth
retrying).

Run `orgcli guide` for the recommended agent workflow.
"""

from __future__ import annotations

import argparse
import difflib
import errno
import hashlib
import json
import os
import re
import shutil
import signal
import sys
import tempfile
import time
import uuid

# ---------------------------------------------------------------------------
# Exit codes. 0/1/2/4 match the cfnote scripts these replace; 3 and 5 are new.
# ---------------------------------------------------------------------------

EXIT_OK = 0
EXIT_NO_MATCH = 1
EXIT_USAGE = 2
EXIT_PRECONDITION = 3
EXIT_AMBIGUOUS = 4
EXIT_UNAVAILABLE = 5

# Used when a file declares no #+TODO:/#+SEQ_TODO: of its own. The corpus needs
# this: tools.org declares nothing yet has headings like "* TODO KFS", and the
# files that do declare keywords disagree with each other (daily.org has PROG
# and CANCELLED, monthly.org has INPROGRESS and CANCELED). The fallback is the
# union of everything actually in use, so a keyword is never mistaken for the
# first word of a title.
DEFAULT_TODO = ["TODO", "PROG", "INPROGRESS", "NEXT", "WAITING", "HOLD"]
DEFAULT_DONE = ["DONE", "CANCELLED", "CANCELED", "MISS"]

DEFAULT_ORG_DIR = "~/gdrive/org-meta"
DEFAULT_CACHE_DIR = "~/.cache/orgcli"
DEFAULT_BACKUP_DIR = "~/.cache/orgcli/backups"
BACKUP_KEEP = 50

HASH_LEN = 12

# How long any single command may spend in the filesystem before we give up and
# call the mount hung. 0 disables. See note in run_with_timeout(): a FUSE call
# in uninterruptible sleep cannot be cut short from Python, so this is a good
# guard against a slow mount and a weak one against a wedged one.
DEFAULT_TIMEOUT = 10

# errnos that mean "the storage went away", as opposed to "you asked for the
# wrong thing". A dead fuse.rclone mount gives ENOTCONN; a mount that was
# unmounted underneath us gives ENOENT (handled separately, in
# classify_oserror); gdrive quota exhaustion gives EDQUOT/ENOSPC.
STORAGE_ERRNOS = frozenset(x for x in (
    getattr(errno, name, None) for name in (
        "EIO", "ENOTCONN", "ESTALE", "EROFS", "ENOSPC", "EDQUOT", "ENODEV",
        "ETIMEDOUT", "EHOSTDOWN", "EHOSTUNREACH", "ENXIO", "EREMOTEIO",
    )) if x is not None)

# ---------------------------------------------------------------------------
# Line-level regexes. All match against newline-stripped text, never raw lines.
# ---------------------------------------------------------------------------

HEADING_RE = re.compile(r"^(\*+)[ \t]+(.*)$")
# A bare "*" line with no title is a valid org heading too, but never appears in
# this corpus and matching it would swallow bullet lines. Require the space.

BEGIN_RE = re.compile(r"^[ \t]*#\+begin_(\S+)", re.IGNORECASE)
END_RE = re.compile(r"^[ \t]*#\+end_(\S+)", re.IGNORECASE)

# Trailing ":tag:tag:" on a heading.
TAGS_RE = re.compile(r"[ \t]+(:(?:[A-Za-z0-9_@#%]+:)+)[ \t]*$")
PRIORITY_RE = re.compile(r"^\[#([A-Za-z0-9])\][ \t]*")

PLANNING_RE = re.compile(r"^[ \t]*(?:SCHEDULED|DEADLINE|CLOSED):", re.IGNORECASE)
PROPERTIES_RE = re.compile(r"^([ \t]*):PROPERTIES:[ \t]*$", re.IGNORECASE)
DRAWER_OPEN_RE = re.compile(r"^([ \t]*):([A-Za-z0-9_-]+):[ \t]*$")
DRAWER_END_RE = re.compile(r"^[ \t]*:END:[ \t]*$", re.IGNORECASE)
PROP_LINE_RE = re.compile(r"^([ \t]*):([^:\s]+?)(\+?):[ \t]*(.*?)[ \t]*$")

TODO_DIRECTIVE_RE = re.compile(r"^#\+(SEQ_TODO|TYP_TODO|TODO):[ \t]*(.*)$", re.IGNORECASE)

# Emacs writes properties as "%-10s %s" - keep the same shape so a drawer this
# tool creates is indistinguishable from one Emacs created.
PROP_KEY_WIDTH = 10

# The command line as invoked, recorded on queued edits so `orgcli pending`
# can show what an edit was. Set by main(); never used to replay.
ARGV = []


class OrgCliError(Exception):
    code = EXIT_USAGE

    def __init__(self, message, code=None):
        super().__init__(message)
        self.message = message
        if code is not None:
            self.code = code


class UsageError(OrgCliError):
    code = EXIT_USAGE


class NotFoundError(OrgCliError):
    code = EXIT_NO_MATCH


class PreconditionError(OrgCliError):
    code = EXIT_PRECONDITION


class AmbiguousError(OrgCliError):
    code = EXIT_AMBIGUOUS

    def __init__(self, message, candidates):
        super().__init__(message)
        self.candidates = candidates


class StorageError(OrgCliError):
    """The filesystem, not the request, is at fault - retry later.

    Kept distinct from UsageError so an agent can tell "there is no such node"
    (exit 1) and "you asked for something impossible" (exit 2) apart from "the
    gdrive mount is down" (exit 5), which is the only one worth retrying.
    """
    code = EXIT_UNAVAILABLE


def classify_oserror(exc, path=None):
    """Turn an OSError into the right OrgCliError. Never returns None.

    ENOENT is the awkward one: a mount that went away leaves the same errno as
    a typo'd filename, and the two want opposite exit codes - 5 says retry, 2
    says fix your command. Two independent tiebreakers, because the mirror is
    off by default and so usually cannot help:

      * The parent directory is missing. `~/gdrive/org-meta` only disappears
        when the mount does; a mistyped *filename* still has its directory.
      * We have read this exact path before, so it is not a typo. Only
        available when ORGCLI_MIRROR=1.
    """
    err = getattr(exc, "errno", None)
    if err in STORAGE_ERRNOS:
        return StorageError("%s is unavailable: %s (errno %s)"
                            % (path or "storage", exc.strerror or exc,
                               errno.errorcode.get(err, err)))
    if err == errno.ENOENT and path:
        parent = os.path.dirname(os.path.abspath(path))
        if not os.path.isdir(parent):
            return StorageError(
                "%s is unavailable: its directory %s does not exist either, "
                "which usually means the mount went away rather than that the "
                "path is wrong." % (path, parent))
        if mirror_has(path):
            return StorageError(
                "%s has gone away: %s. It was readable before, so this is "
                "most likely the mount, not a bad path."
                % (path, exc.strerror or exc))
    if err == errno.ENOENT:
        return UsageError("no such file: %s" % (path or exc))
    if err in (errno.EISDIR, errno.ENOTDIR):
        return UsageError("not a file: %s" % (path or exc))
    return UsageError("cannot access %s: %s" % (path or "file", exc))


# ---------------------------------------------------------------------------
# Line handling
#
# Lines are kept raw (with their terminator) so ''.join(lines) reproduces the
# file byte for byte. We split on '\n' only - str.splitlines() would also break
# on form feed, which Emacs uses as a page separator, and on U+2028, silently
# shifting every line number away from what `wc -l` and `Grep` report.
# ---------------------------------------------------------------------------


def split_lines(text):
    if text == "":
        return []
    parts = text.split("\n")
    if parts[-1] == "":
        parts.pop()
        return [p + "\n" for p in parts]
    return [p + "\n" for p in parts[:-1]] + [parts[-1]]


def strip_eol(line):
    if line.endswith("\n"):
        line = line[:-1]
    if line.endswith("\r"):
        line = line[:-1]
    return line


def text_to_lines(text, nl="\n"):
    """Turn a blob of user-supplied text into terminated org lines."""
    if text == "":
        return []
    if text.endswith("\n"):
        text = text[:-1]
    return [strip_eol(p) + nl for p in text.split("\n")]


def ensure_terminated(lines, nl="\n"):
    """Every line but the last must end in a newline, or the file is corrupt."""
    out = list(lines)
    for i in range(len(out) - 1):
        if not out[i].endswith("\n"):
            out[i] = out[i] + nl
    return out


def norm(text):
    """Comparison form for titles: case- and whitespace-insensitive."""
    return " ".join(text.lower().split())


# ---------------------------------------------------------------------------
# Storage: the mount, the local mirror, and the pending-write queue
#
# The notes live on a fuse.rclone gdrive mount that dies periodically. Three
# layers keep that from blocking an agent mid-session:
#
#   1. Every successful read is copied to ~/.cache/orgcli/mirror.
#   2. When a read fails, it is served from the mirror and flagged stale.
#   3. A write that cannot reach the mount - either because it failed, or
#      because the doc it edited came from the mirror and might be behind the
#      real file - is written to ~/.cache/orgcli/pending instead, with the
#      sha of the content it was computed against. `orgcli sync` replays it
#      once the mount is back, and refuses if that sha no longer matches.
#
# Nothing here changes behaviour when the mount is healthy: the mirror write
# is skipped when the content is unchanged, and the queue is never touched.
# ---------------------------------------------------------------------------


def cache_dir():
    return os.path.expanduser(os.environ.get("ORGCLI_CACHE_DIR", DEFAULT_CACHE_DIR))


def mirror_dir():
    return os.path.join(cache_dir(), "mirror")


def pending_dir():
    return os.path.join(cache_dir(), "pending")


def sha_of(text):
    return hashlib.sha1(text.encode("utf-8")).hexdigest()


def cache_key(path):
    """Filename-safe, collision-free stand-in for an absolute path."""
    return hashlib.sha1(os.path.abspath(path).encode("utf-8")).hexdigest()[:16]


def now_stamp():
    return time.strftime("%Y-%m-%dT%H:%M:%S")


def warn(message):
    """Degraded-mode notices go to stderr so --json output stays parseable."""
    sys.stderr.write("orgcli: %s\n" % message)


def fault(kind):
    """Test seam: ORGCLI_FAULT fakes a broken mount. Inert unless set.

        read    reads fail                 write   writes fail
        rename  only the final os.replace fails - the case the deleted
                truncate-and-write fallback used to paper over
        both    reads and writes fail      hang    everything blocks

    This exists because none of the degraded paths can be exercised without
    unmounting the developer's live gdrive, and it doubles as a way to
    rehearse recovery by hand.
    """
    want = os.environ.get("ORGCLI_FAULT")
    if not want:
        return
    if want == "hang":
        time.sleep(3600)
    if want == kind or want == "both":
        raise OSError(errno.ENOTCONN, "Transport endpoint is not connected")


# -- raw file IO ------------------------------------------------------------


def raw_read(path):
    """Read from possibly-broken storage. Raises OSError; callers classify."""
    fault("read")
    with open(path, "r", encoding="utf-8", newline="") as fh:
        return fh.read()


def _replace(src, dst, faultable):
    """os.replace, with the fault seam *inside* the call rather than before it.

    That placement is deliberate: it means a future truncate-and-write
    fallback wrapped around this call would catch the simulated error, and
    tests/test_orgcli.py would notice.
    """
    if faultable:
        fault("rename")
    os.replace(src, dst)


def _write_atomically(path, content, faultable=False):
    """Temp file in the same directory, then os.replace.

    There is deliberately no truncate-and-write fallback. An earlier version
    had one, in case a FUSE mount ever rejected rename-over-existing - but on
    a *flaky* mount that turns a cleanly failed write into a truncated org
    file. Letting the error out is better: commit() turns it into a queued
    edit, which loses nothing.
    """
    directory = os.path.dirname(path) or "."
    mode = None
    try:
        mode = os.stat(path).st_mode
    except OSError:
        pass
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".orgcli-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="") as fh:
            fh.write(content)
        if mode is not None:
            os.chmod(tmp, mode)
        _replace(tmp, path, faultable)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def atomic_write(path, content):
    """Write an org file. May raise OSError if the mount is unhappy."""
    fault("write")
    _write_atomically(path, content, faultable=True)


def local_write(path, content):
    """Write inside the cache dir. Never fault-injected: the cache is on local
    disk, and simulating gdrive being down must not simulate that failing too.
    """
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    _write_atomically(path, content)


# -- mirror -----------------------------------------------------------------


def mirror_paths(path):
    base = os.path.join(mirror_dir(), cache_key(path))
    return base + ".org", base + ".json"


def mirror_has(path):
    try:
        return os.path.exists(mirror_paths(path)[0])
    except OSError:
        return False


def mirror_get(path):
    """(content, info) for the last good read of `path`, or None."""
    body, meta = mirror_paths(path)
    try:
        with open(body, "r", encoding="utf-8", newline="") as fh:
            content = fh.read()
        with open(meta, "r", encoding="utf-8") as fh:
            info = json.load(fh)
    except (OSError, ValueError):
        return None
    return content, info


def mirroring_enabled():
    """Off unless ORGCLI_MIRROR=1.

    Mirroring every read buys offline reads, at the cost of a second copy of
    the notes on local disk that can be served in place of the real file
    without being asked for. Opt in when you want the former; the queue below
    works either way.
    """
    return os.environ.get("ORGCLI_MIRROR", "0") not in ("0", "", "no", "off")


def mirror_put(path, content, force=False):
    """Record a known-good state. Best effort: a cache problem must never
    turn a working read or write into a failure.

    `force` bypasses the ORGCLI_MIRROR setting. The queue uses it: chaining
    one offline edit onto the next is the queue's own bookkeeping, not read
    caching, and the mirror being off must not quietly make the queue unsound.
    """
    if not force and not mirroring_enabled():
        return
    digest = sha_of(content)
    existing = mirror_get(path)
    if existing and existing[1].get("sha") == digest:
        return  # unchanged - re-reading a 24k-line file costs a hash, not a copy
    body, meta = mirror_paths(path)
    try:
        local_write(body, content)
        local_write(meta, json.dumps({
            "path": os.path.abspath(path),
            "sha": digest,
            "size": len(content),
            "read_at": now_stamp(),
        }, indent=2) + "\n")
    except OSError:
        pass


# -- pending-write queue ----------------------------------------------------


def queue_entries(path=None):
    """Queued edits, oldest first, optionally filtered to one file."""
    try:
        names = sorted(n for n in os.listdir(pending_dir()) if n.endswith(".json"))
    except OSError:
        return []
    want = os.path.abspath(path) if path else None
    out = []
    for name in names:
        meta = os.path.join(pending_dir(), name)
        try:
            with open(meta, "r", encoding="utf-8") as fh:
                entry = json.load(fh)
        except (OSError, ValueError):
            continue
        if want and entry.get("file") != want:
            continue
        entry["_meta"] = meta
        entry["_body"] = meta[:-len(".json")] + ".content"
        out.append(entry)
    return out


def queue_put(path, pre_sha, post_sha, content, reason):
    """Park an edit for later. Stores the resulting content, not the command.

    Replaying the content is byte-identical to re-running the command whenever
    the pre_sha still matches - which is the only case sync ever applies - and
    it sidesteps argv normalisation, consumed stdin and $ORGCLI_DIR drift.
    The argv is recorded for `orgcli pending` to display, never for replay.
    """
    seq = 0
    stamp = time.strftime("%Y%m%d-%H%M%S")
    while True:
        # <stamp>-<pid>-<seq> sorts lexically into creation order.
        entry_id = "%s-%05d-%02d" % (stamp, os.getpid(), seq)
        meta = os.path.join(pending_dir(), entry_id + ".json")
        if not os.path.exists(meta):
            break
        seq += 1
    local_write(meta[:-len(".json")] + ".content", content)
    local_write(meta, json.dumps({
        "id": entry_id,
        "created": now_stamp(),
        "file": os.path.abspath(path),
        "argv": list(ARGV),
        "pre_sha": pre_sha,
        "post_sha": post_sha,
        "reason": reason,
    }, indent=2) + "\n")
    return entry_id


def queue_drop(entry):
    for key in ("_body", "_meta"):
        try:
            os.remove(entry[key])
        except OSError:
            pass


def queue_content(entry):
    try:
        with open(entry["_body"], "r", encoding="utf-8", newline="") as fh:
            return fh.read()
    except OSError as exc:
        raise UsageError("queued edit %s has lost its content file (%s); "
                         "drop it with: orgcli pending --drop %s"
                         % (entry["id"], exc, entry["id"]))


# -- timeout ----------------------------------------------------------------


def timeout_seconds():
    raw = os.environ.get("ORGCLI_TIMEOUT")
    if raw is None:
        return DEFAULT_TIMEOUT
    try:
        return max(0, float(raw))
    except ValueError:
        raise UsageError("ORGCLI_TIMEOUT must be a number of seconds, got %r" % raw)


def _on_alarm(signum, frame):
    raise StorageError(
        "timed out after %gs waiting on the filesystem; the mount may be hung. "
        "Raise or disable the limit with ORGCLI_TIMEOUT." % timeout_seconds())


def arm_timeout(seconds=None):
    """(Re)start the watchdog. Returns False if this platform has no SIGALRM.

    Caveat worth knowing: a FUSE request in uninterruptible sleep will not
    deliver the signal until the syscall returns, so this reliably catches a
    *slow* mount and only sometimes catches a *wedged* one.
    """
    if not hasattr(signal, "SIGALRM"):
        return False
    if seconds is None:
        seconds = timeout_seconds()
    if not seconds:
        return False
    signal.signal(signal.SIGALRM, _on_alarm)
    signal.setitimer(signal.ITIMER_REAL, seconds)
    return True


def disarm_timeout():
    if hasattr(signal, "SIGALRM"):
        signal.setitimer(signal.ITIMER_REAL, 0)


# ---------------------------------------------------------------------------
# Nodes
# ---------------------------------------------------------------------------


class Node:
    __slots__ = (
        "level", "start", "end", "todo", "priority", "title", "tags",
        "commented", "parent", "children", "idx",
    )

    def __init__(self, level, start):
        self.level = level
        self.start = start          # index of the heading line
        self.end = start + 1        # exclusive; end of the whole subtree
        self.todo = None
        self.priority = None
        self.title = ""
        self.tags = []
        self.commented = False
        self.parent = None
        self.children = []
        self.idx = -1

    @property
    def line(self):
        """1-based line number of the heading."""
        return self.start + 1

    @property
    def own_end(self):
        """End of this node's own content, excluding descendant subtrees."""
        return self.children[0].start if self.children else self.end

    def ancestors(self):
        out = []
        n = self.parent
        while n is not None:
            out.append(n)
            n = n.parent
        out.reverse()
        return out

    def path(self):
        return "/".join(escape_seg(n.title) for n in self.ancestors() + [self])


def escape_seg(title):
    return title.replace("\\", "\\\\").replace("/", "\\/")


def split_path(spec):
    """Split a --path on unescaped '/'. Backslash escapes '/' and itself."""
    segs, cur, esc = [], [], False
    for ch in spec:
        if esc:
            cur.append(ch)
            esc = False
        elif ch == "\\":
            esc = True
        elif ch == "/":
            segs.append("".join(cur))
            cur = []
        else:
            cur.append(ch)
    if esc:
        cur.append("\\")
    segs.append("".join(cur))
    segs = [s.strip() for s in segs]
    return [s for s in segs if s != ""]


# ---------------------------------------------------------------------------
# Document
# ---------------------------------------------------------------------------


class OrgDoc:
    def __init__(self, path, lines):
        self.path = path
        self.lines = lines
        self.nl = "\n"
        for ln in lines:
            if ln.endswith("\r\n"):
                self.nl = "\r\n"
                break
            if ln.endswith("\n"):
                break
        self.text = [strip_eol(ln) for ln in lines]
        self.todo_keywords = []
        self.done_keywords = []
        self.nodes = []
        self.roots = []
        self._owner = None
        # True when this content came from the local mirror because the real
        # file was unreachable. Writes refuse to touch the mount in that state.
        self.stale = False
        self.mirror_read_at = None
        self._parse()

    # -- loading ----------------------------------------------------------

    @classmethod
    def load(cls, path, allow_mirror=True):
        """Read `path`, falling back to the mirror when storage is down.

        `allow_mirror=False` is for sync, which must compare against what is
        actually on the mount and would be meaningless against a cached copy.
        """
        try:
            raw = raw_read(path)
        except OSError as exc:
            err = classify_oserror(exc, path)
            cached = mirror_get(path) if allow_mirror else None
            if cached is None:
                raise err
            content, info = cached
            doc = cls(path, split_lines(content))
            doc.stale = True
            doc.mirror_read_at = info.get("read_at")
            warn("%s is unreachable (%s); serving the copy mirrored at %s. "
                 "Writes will be queued, not applied."
                 % (path, err.message, doc.mirror_read_at or "an unknown time"))
            return doc
        mirror_put(path, raw)
        return cls(path, split_lines(raw))

    def content(self):
        return "".join(self.lines)

    # -- parsing ----------------------------------------------------------

    def _parse(self):
        self._scan_keywords()
        self._scan_headings()

    def _scan_keywords(self):
        """Collect #+TODO:/#+SEQ_TODO:/#+TYP_TODO: declarations.

        Several files declare more than one line (daily.org has two), so the
        sets accumulate. '|' separates not-done from done states; with no '|'
        org treats the last keyword as the done state.
        """
        todo, done = [], []
        for text in self.text:
            m = TODO_DIRECTIVE_RE.match(text)
            if not m:
                continue
            spec = m.group(2)
            before, sep, after = spec.partition("|")
            pre = [strip_fast_key(w) for w in before.split()]
            post = [strip_fast_key(w) for w in after.split()]
            if not sep and pre:
                post = [pre.pop()]
            todo.extend(w for w in pre if w)
            done.extend(w for w in post if w)
        if not todo and not done:
            todo, done = list(DEFAULT_TODO), list(DEFAULT_DONE)
        self.todo_keywords = dedupe(todo)
        self.done_keywords = dedupe(done)

    @property
    def all_keywords(self):
        return self.todo_keywords + self.done_keywords

    def _scan_headings(self):
        """One pass for headings, suppressing detection inside blocks.

        tools.org alone has 270 #+begin_src blocks and shell snippets inside
        them start lines with '*' often enough to matter. Org's own escape for
        a literal '*' at column 0 in a body is a leading comma (',*'), which
        HEADING_RE cannot match anyway - noted here so nobody "simplifies" the
        regex into one that can.
        """
        block = None
        stack = []
        for i, text in enumerate(self.text):
            if block is None:
                m = BEGIN_RE.match(text)
                if m:
                    block = m.group(1).lower()
                    continue
            else:
                m = END_RE.match(text)
                # Only a matching #+end_ closes the block, so a stray one in
                # prose cannot desync the rest of the file.
                if m and m.group(1).lower() == block:
                    block = None
                continue

            m = HEADING_RE.match(text)
            if not m:
                continue
            node = Node(len(m.group(1)), i)
            parse_heading(node, m.group(2), self.all_keywords)
            while stack and stack[-1].level >= node.level:
                stack.pop().end = i
            if stack:
                node.parent = stack[-1]
                stack[-1].children.append(node)
            else:
                self.roots.append(node)
            node.idx = len(self.nodes)
            self.nodes.append(node)
            stack.append(node)

        for node in stack:
            node.end = len(self.lines)
        # An unterminated block leaves every following heading unseen; loud
        # enough to matter, quiet enough not to block a read.
        if block is not None:
            warn("unterminated #+begin_%s in %s; headings after it were not "
                 "parsed" % (block, self.path))

    # -- zones ------------------------------------------------------------

    def planning_end(self, node):
        """First line after the heading's planning lines."""
        i = node.start + 1
        limit = node.own_end
        while i < limit and PLANNING_RE.match(self.text[i]):
            i += 1
        return i

    def drawer_span(self, node):
        """(start, end) of the :PROPERTIES: drawer, or None.

        Org requires the drawer immediately after the heading and its planning
        line, and so do we - a ':PROPERTIES:' further down is body content.
        """
        i = self.planning_end(node)
        if i >= node.own_end or not PROPERTIES_RE.match(self.text[i]):
            return None
        j = i + 1
        while j < node.own_end:
            if DRAWER_END_RE.match(self.text[j]):
                return (i, j + 1)
            j += 1
        return None  # unterminated drawer: treat as body, do not guess

    def body_start(self, node):
        span = self.drawer_span(node)
        return span[1] if span else self.planning_end(node)

    def properties(self, node):
        span = self.drawer_span(node)
        if not span:
            return {}
        props = {}
        for i in range(span[0] + 1, span[1] - 1):
            m = PROP_LINE_RE.match(self.text[i])
            if not m:
                continue
            key, plus, value = m.group(2), m.group(3), m.group(4)
            if plus and key in props:
                props[key] = (props[key] + " " + value).strip()
            else:
                props[key] = value
        return props

    def prop(self, node, key):
        return self.properties(node).get(key)

    # -- descriptions -----------------------------------------------------

    def description(self, node):
        """:DESCRIPTION: property, else a '** description' child, else None.

        The child form is what tools.org uses for ~30 of its level-1 nodes; it
        stays readable so nothing has to be migrated before this tool is
        useful. Writes always go to the property.
        """
        value = self.prop(node, "DESCRIPTION")
        if value:
            return value
        child = self.description_child(node)
        if child is not None:
            return self.flatten(child)
        return None

    def description_child(self, node):
        for child in node.children:
            if norm(child.title) == "description":
                return child
        return None

    def flatten(self, node):
        """Collapse a node's body to one line, the way cfnote's indexer did."""
        body = self.text[self.body_start(node):node.end]
        return " ".join(" ".join(body).split())

    # -- lookup -----------------------------------------------------------

    def owner_of(self, index):
        """Deepest node whose span contains this line index, or None."""
        if self._owner is None:
            owner = [None] * len(self.lines)
            # Document order means a child is always assigned after its parent
            # and so wins for the lines they share.
            for node in self.nodes:
                for i in range(node.start, node.end):
                    owner[i] = node
            self._owner = owner
        return self._owner[index]

    def find_by_line(self, line):
        for node in self.nodes:
            if node.line == line:
                return node
        raise NotFoundError("no heading starts at line %d in %s" % (line, self.path))

    def find_by_id(self, node_id):
        want = node_id.strip().lower()
        hits = [n for n in self.nodes if (self.prop(n, "ID") or "").lower() == want]
        if not hits:
            raise NotFoundError("no node with :ID: %s in %s" % (node_id, self.path))
        if len(hits) > 1:
            raise AmbiguousError("duplicate :ID: %s" % node_id, hits)
        return hits[0]

    def find_by_path(self, spec, strict_root=False):
        hits = self._path_hits(split_path(spec), strict_root)
        if not hits and "/" in spec:
            # 8 of tools.org's 120 level-1 titles contain a literal slash
            # ("ssh / sush", "lldb / gdb", "misc tools/services"), and an agent
            # copying a title out of the index has no reason to know it needs
            # escaping. If the segmented reading finds nothing, try the whole
            # spec as one title. Segmented always wins when it matches, so this
            # can never reinterpret a working path.
            hits = self._path_hits([spec.replace("\\/", "/")], strict_root)
        if not hits:
            raise NotFoundError(
                'no node matching path "%s" in %s%s'
                % (spec, self.path,
                   "" if "/" in spec else
                   " (paths are parent/child; try `orgcli search` if you are "
                   "guessing at the title)"))
        if len(hits) > 1:
            # Prefer a single shallowest match: 'acl' should not be ambiguous
            # just because some deeper node is also called 'acl'.
            best = min(n.level for n in hits)
            shallow = [n for n in hits if n.level == best]
            if len(shallow) == 1:
                return shallow[0]
            raise AmbiguousError('path "%s" matches %d nodes' % (spec, len(hits)), hits)
        return hits[0]

    def _path_hits(self, segs, strict_root):
        if not segs:
            raise UsageError("empty --path")
        want = [norm(s) for s in segs]
        hits = []
        for node in self.nodes:
            top = self._match_chain(node, want)
            if top is None:
                continue
            if strict_root and top.parent is not None:
                continue
            hits.append(node)
        return hits

    def _match_chain(self, node, want):
        """Does `node` end a contiguous ancestor chain matching `want`?

        Returns the topmost matched node, or None.
        """
        cur = node
        for seg in reversed(want):
            if cur is None or norm(cur.title) != seg:
                return None
            top = cur
            cur = cur.parent
        return top

    def resolve(self, args, required=True):
        given = [x for x in (args.path, args.id, args.line) if x is not None]
        if len(given) > 1:
            raise UsageError("give only one of --path, --id, --line")
        if not given:
            if required:
                raise UsageError("one of --path, --id, --line is required")
            return None
        if args.path is not None:
            return self.find_by_path(args.path, getattr(args, "strict_root", False))
        if args.id is not None:
            return self.find_by_id(args.id)
        return self.find_by_line(args.line)

    # -- hashing ----------------------------------------------------------

    def subtree_text(self, node):
        return "".join(self.lines[node.start:node.end])

    def hash(self, node):
        digest = hashlib.sha1(self.subtree_text(node).encode("utf-8"))
        return digest.hexdigest()[:HASH_LEN]


def dedupe(seq):
    seen, out = set(), []
    for x in seq:
        if x not in seen:
            seen.add(x)
            out.append(x)
    return out


def strip_fast_key(word):
    """'PROG(p)' -> 'PROG', 'CANCELLED(c@/!)' -> 'CANCELLED'."""
    return word.split("(", 1)[0].strip()


def parse_heading(node, rest, keywords):
    """Decompose '[KW] [COMMENT] [#A] title :tag:tag:'."""
    m = TAGS_RE.search(rest)
    if m:
        node.tags = [t for t in m.group(1).split(":") if t]
        rest = rest[:m.start()]
    rest = rest.strip()
    for kw in keywords:
        if rest == kw or rest.startswith(kw + " "):
            node.todo = kw
            rest = rest[len(kw):].strip()
            break
    if rest == "COMMENT" or rest.startswith("COMMENT "):
        node.commented = True
        rest = rest[len("COMMENT"):].strip()
    m = PRIORITY_RE.match(rest)
    if m:
        node.priority = m.group(1)
        rest = rest[m.end():].strip()
    node.title = rest


def render_heading(node, nl="\n"):
    parts = ["*" * node.level]
    if node.todo:
        parts.append(node.todo)
    if node.commented:
        parts.append("COMMENT")
    if node.priority:
        parts.append("[#%s]" % node.priority)
    if node.title:
        parts.append(node.title)
    line = " ".join(parts)
    if node.tags:
        line += " :" + ":".join(node.tags) + ":"
    return line + nl


def warn(message):
    sys.stderr.write("orgcli: warning: %s\n" % message)


# ---------------------------------------------------------------------------
# File resolution
# ---------------------------------------------------------------------------


def org_dir():
    return os.path.expanduser(os.environ.get("ORGCLI_DIR", DEFAULT_ORG_DIR))


def resolve_file(spec):
    """'tools' -> $ORGCLI_DIR/tools.org; anything path-like is used as given."""
    if spec is None:
        spec = os.environ.get("ORGCLI_FILE")
    if not spec:
        raise UsageError(
            "no file given: pass --file, or set ORGCLI_FILE. A bare name like "
            "'tools' resolves to %s/tools.org" % org_dir())
    spec = os.path.expanduser(spec)
    if os.sep in spec or spec.startswith(".") or spec.endswith(".org"):
        return os.path.abspath(spec)
    return os.path.join(org_dir(), spec + ".org")


def load(args):
    return OrgDoc.load(resolve_file(args.file))


# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------


def section(name, body=None):
    sys.stdout.write("---%s---\n" % name)
    if body is None:
        return
    if not body.endswith("\n"):
        body += "\n"
    sys.stdout.write(body)


def emit_json(payload):
    sys.stdout.write(json.dumps(payload, indent=2, ensure_ascii=False) + "\n")


def human_size(n):
    if n < 1024:
        return "%dB" % n
    if n < 1024 * 1024:
        return "%.1fK" % (n / 1024.0)
    return "%.1fM" % (n / (1024.0 * 1024))


def node_label(doc, node, stats=False, desc=False):
    """One line describing a node, used by outline and candidate listings."""
    label = node.title or "(untitled)"
    if node.todo:
        label = "%s %s" % (node.todo, label)
    if node.priority:
        label = "[#%s] %s" % (node.priority, label)
    if node.tags:
        label += "  :" + ":".join(node.tags) + ":"
    if stats:
        nlines = node.end - node.start
        nbytes = len(doc.subtree_text(node).encode("utf-8"))
        label += "  (%dL %s)" % (nlines, human_size(nbytes))
    if desc:
        text = doc.description(node)
        if text:
            label += "  :: " + text
    return label


def node_dict(doc, node, include_body=False):
    payload = {
        "path": node.path(),
        "title": node.title,
        "level": node.level,
        "start": node.line,
        "end": node.end,
        "lines": node.end - node.start,
        "hash": doc.hash(node),
        "todo": node.todo,
        "tags": node.tags,
        "priority": node.priority,
        "id": doc.prop(node, "ID"),
        "description": doc.description(node),
    }
    if include_body:
        payload["body"] = "".join(doc.lines[doc.body_start(node):node.own_end])
        payload["text"] = doc.subtree_text(node)
    return payload


def node_summary(doc, node):
    bits = [
        "path=%s" % node.path(),
        "level=%d" % node.level,
        "lines=%d-%d" % (node.line, node.end),
        "hash=%s" % doc.hash(node),
    ]
    node_id = doc.prop(node, "ID")
    if node_id:
        bits.append("id=%s" % node_id)
    if node.todo:
        bits.append("todo=%s" % node.todo)
    if node.tags:
        bits.append("tags=%s" % ":".join(node.tags))
    return "  ".join(bits)


def print_candidates(doc, candidates):
    section("CANDIDATES")
    for node in candidates:
        sys.stdout.write("%6d\t%s\n" % (node.line, node.path()))


# ---------------------------------------------------------------------------
# Writing
# ---------------------------------------------------------------------------


def backup_dir():
    return os.path.expanduser(os.environ.get("ORGCLI_BACKUP_DIR", DEFAULT_BACKUP_DIR))


def make_backup(path, content=None):
    """Snapshot `path` to local disk before overwriting it.

    `content` short-circuits the re-read when the caller already has the bytes,
    which matters on a slow mount and avoids a second chance to fail.
    """
    directory = backup_dir()
    os.makedirs(directory, exist_ok=True)
    base = os.path.basename(path)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    dest = os.path.join(directory, "%s.%s-%d" % (base, stamp, os.getpid()))
    if content is None:
        shutil.copy2(path, dest)
    else:
        with open(dest, "w", encoding="utf-8", newline="") as fh:
            fh.write(content)
    prune_backups(directory, base)
    return dest


def prune_backups(directory, base):
    prefix = base + "."
    try:
        names = [n for n in os.listdir(directory) if n.startswith(prefix)]
    except OSError:
        return
    if len(names) <= BACKUP_KEEP:
        return
    names.sort()
    for name in names[:-BACKUP_KEEP]:
        try:
            os.remove(os.path.join(directory, name))
        except OSError:
            pass


def diff_text(old, new, path):
    return "".join(difflib.unified_diff(
        split_lines(old), split_lines(new),
        fromfile=path, tofile=path + " (new)", n=3))


def report(args, status, path, extra=None, **fields):
    """Emit a write result as ---SECTION--- blocks, or as JSON with --json.

    Commands that both read and write (id, describe) register --json, so a
    write has to honour it too rather than silently falling back to sections.
    """
    if getattr(args, "json", False):
        payload = {"file": path, "status": status}
        payload.update({k: v for k, v in fields.items() if v is not None})
        for name, body in extra or []:
            if body is not None:
                payload[name.lower()] = body.rstrip("\n") if name != "DIFF" else body
        emit_json(payload)
        return EXIT_OK
    section("FILE", path)
    bits = ["status=%s" % status]
    for key in ("backup", "lines", "hash", "queued", "reason"):
        if fields.get(key) is not None:
            bits.append("%s=%s" % (key, fields[key]))
    section("RESULT", "  ".join(bits))
    for name, body in extra or []:
        section(name, body)
    return EXIT_OK


def enqueue(doc, args, old_content, new_content, reason, extra=None):
    """Park an edit that could not reach the mount, and update the mirror.

    Reports exit 0 with status=queued: the edit is durably recorded on local
    disk, so the caller has not lost work. It has *not* reached gdrive, which
    is why the status string says so rather than saying "written".
    """
    if os.environ.get("ORGCLI_NO_QUEUE") == "1":
        raise StorageError(
            "cannot write %s (%s) and ORGCLI_NO_QUEUE=1 is set, so the edit "
            "was discarded" % (doc.path, reason))

    # Every queued edit for a file must start from where the previous one
    # ended, or replaying them in order is not equivalent to having run the
    # commands in order. Queueing an edit built on a stale base would look
    # fine here and fail at sync time, after the chance to do something about
    # it has passed - so refuse now, while the content is still in hand.
    old_sha = sha_of(old_content)
    queued = queue_entries(doc.path)
    if queued and queued[-1]["post_sha"] != old_sha:
        raise PreconditionError(
            "%s already has %d queued edit(s), and this one was computed "
            "against a different version of the file (%s, not %s). Queueing "
            "it would silently revert them, so it has been dropped - the "
            "queue is untouched. Flush it with `orgcli sync` once storage is "
            "back, then redo this edit; `orgcli pending -f %s` shows what is "
            "waiting. (Set ORGCLI_MIRROR=1 to let edits stack while the mount "
            "is down.)"
            % (doc.path, len(queued), old_sha[:HASH_LEN],
               queued[-1]["post_sha"][:HASH_LEN], doc.path))

    entry_id = queue_put(doc.path, old_sha, sha_of(new_content),
                         new_content, reason)
    # Chain point: the mirror now holds the post-edit content, so a further
    # offline edit is computed against it and its pre_sha lines up with this
    # entry's post_sha. Forced past ORGCLI_MIRROR=0 - see mirror_put.
    mirror_put(doc.path, new_content, force=True)
    warn("queued edit %s for %s (%s). It is NOT on gdrive yet; it will be "
         "applied by the next write to this file, or by: orgcli sync"
         % (entry_id, doc.path, reason))
    return report(args, "queued", doc.path, extra, queued=entry_id, reason=reason)


def commit(doc, args, new_lines, changed_node=None, extra=None):
    """Shared tail of every write command: guard, diff-or-write, report."""
    new_lines = ensure_terminated(new_lines, doc.nl)
    # A file that ended without a newline keeps ending without one, so an edit
    # elsewhere in the file does not show up as a spurious last-line hunk in
    # git or hg.
    if doc.lines and not doc.lines[-1].endswith("\n") and new_lines:
        new_lines[-1] = strip_eol(new_lines[-1])
    new_content = "".join(new_lines)
    old_content = doc.content()

    if new_content == old_content:
        return report(args, "unchanged", doc.path, extra)

    if getattr(args, "dry_run", False):
        # --dry-run never queues: it is the one mode that promises to leave
        # every kind of state exactly as it found it.
        diff = diff_text(old_content, new_content, doc.path)
        return report(args, "dry-run", doc.path,
                      (extra or []) + [("DIFF", diff)])

    if doc.stale:
        # This edit was computed against the mirror, which may be behind the
        # real file. Writing it to a recovered mount would clobber whatever
        # landed there in the meantime, so queue unconditionally and let sync
        # check the hash later.
        return enqueue(doc, args, old_content, new_content,
                       "read from mirror; mount was unreachable", extra)

    try:
        # Preflight: fail before taking a backup and before touching the file,
        # so a dead mount cannot leave us half-way through a write.
        os.stat(doc.path)
        backup = None
        if not getattr(args, "no_backup", False):
            backup = make_backup(doc.path, old_content)
        atomic_write(doc.path, new_content)
    except OSError as exc:
        err = classify_oserror(exc, doc.path)
        if not isinstance(err, StorageError):
            raise err
        return enqueue(doc, args, old_content, new_content, err.message, extra)

    mirror_put(doc.path, new_content)

    lines = node_hash = None
    if changed_node is not None:
        fresh = OrgDoc(doc.path, new_lines)
        try:
            node = fresh.find_by_line(changed_node)
            lines = "%d-%d" % (node.line, node.end)
            node_hash = fresh.hash(node)
        except OrgCliError:
            pass
    return report(args, "written", doc.path, extra,
                  backup=backup, lines=lines, hash=node_hash)


def check_if_match(doc, node, args):
    want = getattr(args, "if_match", None)
    if not want:
        return
    have = doc.hash(node)
    if want != have:
        raise PreconditionError(
            "--if-match %s but node is now %s; re-read it before writing"
            % (want, have))


# ---------------------------------------------------------------------------
# Property drawer editing
#
# Returns a fresh line list. Callers re-parse rather than patching offsets.
# ---------------------------------------------------------------------------


def format_prop(key, value, indent=""):
    label = ":%s:" % key
    return "%s%s %s" % (indent, label.ljust(PROP_KEY_WIDTH), value)


def set_properties(doc, node, updates):
    """updates: {KEY: value or None to unset}. Returns new lines."""
    lines = list(doc.lines)
    span = doc.drawer_span(node)
    nl = doc.nl

    if span is None:
        wanted = [(k, v) for k, v in updates.items() if v is not None]
        if not wanted:
            return lines
        insert_at = doc.planning_end(node)
        block = [":PROPERTIES:" + nl]
        block += [format_prop(k, v) + nl for k, v in wanted]
        block += [":END:" + nl]
        return lines[:insert_at] + block + lines[insert_at:]

    start, end = span
    m = PROPERTIES_RE.match(doc.text[start])
    indent = m.group(1) if m else ""
    body = []
    seen = set()
    for i in range(start + 1, end - 1):
        pm = PROP_LINE_RE.match(doc.text[i])
        key = pm.group(2) if pm else None
        if key is not None and key in updates:
            if key in seen:
                continue  # collapse duplicates / :KEY+: continuations
            seen.add(key)
            value = updates[key]
            if value is not None:
                body.append(format_prop(key, value, indent) + nl)
            continue
        body.append(lines[i])
    for key, value in updates.items():
        if value is not None and key not in seen:
            body.append(format_prop(key, value, indent) + nl)

    if not body:
        # Last property removed: drop the whole drawer rather than leave an
        # empty one, which org renders as noise.
        return lines[:start] + lines[end:]
    block = [lines[start]] + body + [lines[end - 1]]
    return lines[:start] + block + lines[end:]


def ensure_id(doc, node, lines=None):
    """Return (lines, id). Mints a UUID only if the node has none."""
    existing = doc.prop(node, "ID")
    if existing:
        return (list(doc.lines) if lines is None else lines), existing
    new_id = str(uuid.uuid4())
    return set_properties(doc, node, {"ID": new_id}), new_id


# ---------------------------------------------------------------------------
# Text input
# ---------------------------------------------------------------------------


def read_text(args, required=True):
    """Body text from --text, --text-file, or stdin.

    Agents should prefer stdin/heredoc: it sidesteps shell quoting around org's
    '*' and '=', which is the usual way a hand-built command corrupts a note.
    """
    if getattr(args, "text", None) is not None:
        return args.text
    spec = getattr(args, "text_file", None)
    if spec == "-":
        return sys.stdin.read()
    if spec:
        try:
            with open(os.path.expanduser(spec), "r", encoding="utf-8") as fh:
                return fh.read()
        except OSError as exc:
            raise UsageError("cannot read --text-file: %s" % exc)
    if not required:
        # Body text is optional here (`add` with no body). Never fall through
        # to a bare stdin read: in a pipeline stdin is inherited and may never
        # close, so the command would hang instead of creating an empty node.
        # Ask for stdin explicitly with --text-file - if you want it.
        return None
    if not sys.stdin.isatty():
        return sys.stdin.read()
    raise UsageError("no text given: use --text, --text-file, or pipe stdin")


def begin_write(args):
    """Resolve the target, enforce --if-match, honour --ensure-id."""
    doc = load(args)
    node = doc.resolve(args)
    check_if_match(doc, node, args)
    if getattr(args, "ensure_id", False):
        lines, _ = ensure_id(doc, node)
        doc = OrgDoc(doc.path, ensure_terminated(lines, doc.nl))
        # Inserting a drawer never moves the heading line itself.
        node = doc.find_by_line(node.line)
    return doc, node


# ---------------------------------------------------------------------------
# Read commands
# ---------------------------------------------------------------------------


def in_scope(node, root):
    if root is None:
        return True
    return node is root or root in node.ancestors()


def rel_depth(node, root):
    return node.level if root is None else node.level - root.level + 1


def cmd_outline(args):
    doc = load(args)
    root = doc.resolve(args, required=False)
    rows = []
    for node in doc.nodes:
        if not in_scope(node, root):
            continue
        if args.depth is not None and rel_depth(node, root) > args.depth:
            continue
        if args.todo is not None:
            if not node.todo:
                continue
            if args.todo != "*" and node.todo.upper() != args.todo.upper():
                continue
        if args.tag and args.tag not in node.tags:
            continue
        rows.append(node)

    if args.json:
        emit_json({
            "file": doc.path,
            "count": len(rows),
            "nodes": [node_dict(doc, n) for n in rows],
        })
        return EXIT_OK

    section("FILE", doc.path)
    section("OUTLINE")
    for node in rows:
        indent = "  " * (rel_depth(node, root) - 1)
        sys.stdout.write("%6d  %s%s\n" % (
            node.line, indent, node_label(doc, node, args.stats, args.desc)))
    section("SUMMARY", "nodes=%d" % len(rows))
    return EXIT_OK


def collect_ranges(doc, node, depth):
    """Line ranges for a node shown to a relative depth (None = whole subtree)."""
    if depth is None:
        return [(node.start, node.end)]
    ranges = [(node.start, node.own_end)]
    if depth > 1:
        for child in node.children:
            ranges.extend(collect_ranges(doc, child, depth - 1))
    return ranges


def cmd_show(args):
    doc = load(args)
    node = doc.resolve(args)

    if args.headings_only:
        body = "".join(
            "%6d  %s%s\n" % (n.line, "  " * (n.level - node.level),
                             node_label(doc, n))
            for n in doc.nodes
            if in_scope(n, node))
    elif args.body_only:
        body = "".join(doc.lines[doc.body_start(node):node.own_end])
    else:
        out = []
        for start, end in collect_ranges(doc, node, args.depth):
            out.extend(doc.lines[start:end])
        body = "".join(out)

    truncated = 0
    if args.max_lines is not None:
        kept = split_lines(body)
        if len(kept) > args.max_lines:
            truncated = len(kept) - args.max_lines
            body = "".join(kept[:args.max_lines])

    if args.json:
        payload = node_dict(doc, node, include_body=True)
        payload["file"] = doc.path
        payload["shown"] = body
        payload["truncated"] = truncated
        emit_json(payload)
        return EXIT_OK

    section("FILE", doc.path)
    section("NODE", node_summary(doc, node))
    section("BODY", body)
    if truncated:
        section("SUMMARY", "truncated=%d lines; re-run without --max-lines "
                           "or narrow with --depth" % truncated)
    return EXIT_OK


def cmd_search(args):
    doc = load(args)
    root = doc.resolve(args, required=False)
    flags = re.IGNORECASE if args.ignore_case else 0
    pattern = re.escape(args.pattern) if args.fixed else args.pattern
    try:
        rx = re.compile(pattern, flags)
    except re.error as exc:
        raise UsageError("bad pattern: %s" % exc)

    where = args.where
    hits = []
    for i, text in enumerate(doc.text):
        node = doc.owner_of(i)
        if root is not None and (node is None or not in_scope(node, root)):
            continue
        is_heading = node is not None and node.start == i
        if is_heading and where == "body":
            continue
        if not is_heading and where == "heading":
            continue
        if not rx.search(text):
            continue
        hits.append((i, node, "heading" if is_heading else "body"))
        if len(hits) >= args.limit:
            break

    if args.json:
        emit_json({
            "file": doc.path,
            "count": len(hits),
            "truncated": len(hits) >= args.limit,
            "matches": [{
                "line": i + 1,
                "where": kind,
                "path": n.path() if n else "",
                "text": doc.text[i],
                "context": doc.text[max(0, i - args.context):i + args.context + 1]
                           if args.context else [],
            } for i, n, kind in hits],
        })
        return EXIT_OK

    section("FILE", doc.path)
    section("MATCHES")
    for i, node, kind in hits:
        sys.stdout.write("%6d  %s  [%s]\n" % (
            i + 1, node.path() if node else "(preamble)", kind))
        lo = max(0, i - args.context)
        hi = min(len(doc.text), i + args.context + 1)
        for j in range(lo, hi):
            marker = ">" if j == i else " "
            sys.stdout.write("        %s %s\n" % (marker, doc.text[j]))
    section("SUMMARY", "matches=%d%s" % (
        len(hits), "  truncated=yes" if len(hits) >= args.limit else ""))
    return EXIT_OK if hits else EXIT_NO_MATCH


def cmd_path(args):
    doc = load(args)
    # `path` is the bridge from a grep hit back to an address, and a grep hit is
    # almost never a heading line, so --line here resolves to the node that
    # *contains* the line. Every other command keeps the strict reading: you do
    # not want `delete --line 13` removing the enclosing node because line 13
    # happened to be a bullet inside it.
    match = "exact"
    if args.line is not None and args.path is None and args.id is None:
        if not 1 <= args.line <= len(doc.lines):
            raise UsageError("line %d is outside %s (%d lines)"
                             % (args.line, doc.path, len(doc.lines)))
        node = next((n for n in doc.nodes if n.line == args.line), None)
        if node is None:
            node = doc.owner_of(args.line - 1)
            match = "containing"
            if node is None:
                raise NotFoundError(
                    "line %d is in the preamble, above the first heading of %s"
                    % (args.line, doc.path))
    else:
        node = doc.resolve(args)

    chain = node.ancestors() + [node]
    if args.json:
        payload = node_dict(doc, node)
        payload["file"] = doc.path
        payload["match"] = match
        payload["chain"] = [{"line": n.line, "level": n.level, "title": n.title}
                            for n in chain]
        emit_json(payload)
        return EXIT_OK
    section("FILE", doc.path)
    section("PATH", node.path())
    section("CHAIN")
    for n in chain:
        sys.stdout.write("%6d  %s%s\n" % (n.line, "  " * (n.level - 1), n.title))
    section("NODE", node_summary(doc, node))
    if match == "containing":
        section("SUMMARY", "match=containing (line %d is inside this node, not "
                           "its heading)" % args.line)
    return EXIT_OK


def cmd_props(args):
    doc = load(args)
    node = doc.resolve(args)
    props = doc.properties(node)
    if args.json:
        emit_json({"file": doc.path, "path": node.path(), "properties": props})
        return EXIT_OK
    section("FILE", doc.path)
    section("NODE", node_summary(doc, node))
    section("PROPERTIES")
    for key in sorted(props):
        sys.stdout.write("%s=%s\n" % (key, props[key]))
    return EXIT_OK


def cmd_id(args):
    doc = load(args)
    node = doc.resolve(args)
    if not args.ensure:
        existing = doc.prop(node, "ID")
        if args.json:
            emit_json({"file": doc.path, "path": node.path(), "id": existing})
            return EXIT_OK
        section("FILE", doc.path)
        section("ID", existing or "")
        return EXIT_OK if existing else EXIT_NO_MATCH
    check_if_match(doc, node, args)
    existing = doc.prop(node, "ID")
    if existing:
        section("FILE", doc.path)
        section("ID", existing)
        section("RESULT", "status=unchanged")
        return EXIT_OK
    lines, new_id = ensure_id(doc, node)
    return commit(doc, args, lines, node.line, extra=[("ID", new_id)])


def cmd_describe(args):
    doc = load(args)

    if args.missing:
        root = doc.resolve(args, required=False)
        rows = []
        for node in doc.nodes:
            if not in_scope(node, root):
                continue
            if args.depth is not None and rel_depth(node, root) > args.depth:
                continue
            if doc.description(node):
                continue
            rows.append(node)
        if args.json:
            emit_json({"file": doc.path, "count": len(rows),
                       "nodes": [node_dict(doc, n) for n in rows]})
            return EXIT_OK
        section("FILE", doc.path)
        section("MISSING")
        for node in rows:
            preview = ""
            for text in doc.text[doc.body_start(node):node.own_end]:
                if text.strip():
                    preview = text.strip()[:70]
                    break
            sys.stdout.write("%6d  %-50s  %s\n" % (
                node.line, node.path()[:50], preview))
        section("SUMMARY", "missing=%d" % len(rows))
        return EXIT_OK

    node = doc.resolve(args)

    if args.clear:
        check_if_match(doc, node, args)
        if doc.description_child(node) is not None:
            warn("cleared the :DESCRIPTION: property, but a '** description' "
                 "child remains and will still be used as the description")
        return commit(doc, args, set_properties(doc, node, {"DESCRIPTION": None}),
                      node.line)

    if args.text is not None or args.text_file is not None:
        text = " ".join(read_text(args).split())
        if not text:
            raise UsageError("empty description; use --clear to remove one")
        doc, node = begin_write(args)
        return commit(doc, args, set_properties(doc, node, {"DESCRIPTION": text}),
                      node.line)

    value = doc.description(node)
    source = "property" if doc.prop(node, "DESCRIPTION") else (
        "child" if doc.description_child(node) else "none")
    if args.json:
        emit_json({"file": doc.path, "path": node.path(),
                   "description": value, "source": source})
        return EXIT_OK
    section("FILE", doc.path)
    section("NODE", node_summary(doc, node))
    section("DESCRIPTION", value or "")
    section("SUMMARY", "source=%s" % source)
    return EXIT_OK if value else EXIT_NO_MATCH


def cmd_migrate_descriptions(args):
    """Convert '** description' children into :DESCRIPTION: properties.

    Re-parses after each conversion rather than tracking offsets: 30 nodes over
    6000 lines is milliseconds, and offset bookkeeping across a splice that
    both inserts and deletes is exactly where this kind of tool goes wrong.
    """
    doc = load(args)
    original = doc
    converted = []
    while True:
        target = None
        for node in doc.nodes:
            if doc.prop(node, "DESCRIPTION"):
                continue
            if args.depth is not None and node.level > args.depth:
                continue
            child = doc.description_child(node)
            if child is not None:
                target = (node, child)
                break
        if target is None:
            break
        node, child = target
        text = doc.flatten(child)
        if not text:
            warn("skipping empty '** description' under %s" % node.path())
            # Drop the empty child anyway so the loop terminates.
            lines = list(doc.lines[:child.start]) + list(doc.lines[child.end:])
        else:
            lines = list(doc.lines[:child.start]) + list(doc.lines[child.end:])
            doc = OrgDoc(doc.path, ensure_terminated(lines, doc.nl))
            node = doc.find_by_line(node.line)
            lines = set_properties(doc, node, {"DESCRIPTION": text})
            converted.append(node.path())
        doc = OrgDoc(doc.path, ensure_terminated(lines, doc.nl))

    listing = "".join(p + "\n" for p in converted) or None
    return commit(original, args, doc.lines,
                  extra=[("CONVERTED", listing),
                         ("SUMMARY", "converted=%d" % len(converted))])


# ---------------------------------------------------------------------------
# index - regenerates <file>.index.md in the format cfnote established
# ---------------------------------------------------------------------------


def cmd_index(args):
    doc = load(args)
    index_path = (os.path.abspath(os.path.expanduser(args.index))
                  if args.index else re.sub(r"\.org$", "", doc.path) + ".index.md")

    entries = []
    for node in doc.nodes:
        if node.level > args.depth:
            continue
        title = node.title
        if node.level > 1:
            title = node.path()
        desc = doc.description(node)
        entries.append((node, title, desc))

    body = "".join(
        "- %s: %s\n" % (t, d) if d else "- %s\n" % t
        for _, t, d in entries)

    counts = {}
    for node, title, _ in entries:
        counts.setdefault(norm(title), []).append(node)
    duplicates = {k: v for k, v in counts.items() if len(v) > 1}

    old = ""
    if os.path.exists(index_path):
        try:
            with open(index_path, "r", encoding="utf-8") as fh:
                old = fh.read()
        except OSError as exc:
            raise classify_oserror(exc, index_path)

    old_titles = [re.sub(r": .*$", "", ln[2:]).strip()
                  for ln in old.splitlines() if ln.startswith("- ")]
    new_titles = [t for _, t, _ in entries]
    added = [t for t in new_titles if t not in set(old_titles)]
    removed = [t for t in old_titles if t not in set(new_titles)]

    if args.dry_run:
        status = "dry-run"
    elif not old:
        status = "created"
    elif old == body:
        status = "up-to-date"
    else:
        status = "updated"

    if status in ("created", "updated"):
        # The index is derived, never authored, so there is nothing to queue -
        # if the mount is down, just re-run `orgcli index` when it is back.
        try:
            atomic_write(index_path, body)
        except OSError as exc:
            raise classify_oserror(exc, index_path)

    if args.json:
        emit_json({
            "file": doc.path, "index": index_path, "status": status,
            "headings": len(entries), "added": added, "removed": removed,
            "duplicates": {k: [n.line for n in v] for k, v in duplicates.items()},
            "preview": body if args.dry_run else None,
        })
        return EXIT_OK

    section("FILE", doc.path)
    section("INDEX", index_path)
    section("SUMMARY", "status=%s headings=%d added=%d removed=%d duplicates=%d"
            % (status, len(entries), len(added), len(removed), len(duplicates)))
    if added:
        section("ADDED", "".join(t + "\n" for t in added))
    if removed:
        section("REMOVED", "".join(t + "\n" for t in removed))
    if duplicates:
        # Duplicates make --path ambiguous, which is a hard error at lookup
        # time, so surface them here rather than letting the next read fail.
        section("DUPLICATE-HEADINGS")
        for key in sorted(duplicates):
            for node in duplicates[key]:
                sys.stdout.write("%6d\t%s\n" % (node.line, node.title))
    if args.dry_run:
        section("PREVIEW", body)
    return EXIT_OK


